# Environment Variables Configuration
# Copy this file to .env and fill in your real values.
# NEVER put real API keys or passwords in this .env.example file!
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-f8b2c4e1a6
DATABASE_URL=sqlite:///instance/anemia.db
PORT=5000

# Optional: Add your Gemini API key to enable real AI chatbot responses
# Get one free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
